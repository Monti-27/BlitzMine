# Connect to Supabase via connection pooling
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=20&pool_timeout=10
DATABASE_URL=

# Direct connection to the database. Used for migrations
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DIRECT_URL=

# Redis
REDIS_URL=redis://localhost:6379

# Solana
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com
PROGRAM_ID=CVud2PiM4hYk2YkDa2DZ2dnJwd9gVCXZFJP18DzE1r4F
MAGIC_ROUTER_URL=https://devnet-router.magicblock.app
EPHEMERAL_RPC_URL=https://devnet-as.magicblock.app
EPHEMERAL_WS_URL=wss://devnet-as.magicblock.app
EPHEMERAL_VALIDATOR=MAS1Dt9qreoRMQ14YQuhg8UTZMMzDdKhmkZMECCzk57
ADMIN_KEYPAIR=

# Server
PORT=3001
NODE_ENV=development
# Set true only for intentional staging environments that run devnet/testnet with NODE_ENV=production.
ALLOW_NON_MAINNET_IN_PRODUCTION=false
AUTH_TOKEN_SECRET=change-this-in-production
AUTH_CHALLENGE_TTL_SEC=120
AUTH_ACCESS_TTL_SEC=900
AUTH_REFRESH_TTL_SEC=604800
NEST_LOG_LEVELS=log,warn,error
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Optional alias for PRIVY_APP_SECRET
# PRIVY_SECRET=
# Temporary auth debug logging
AUTH_DEBUG=false
# Optional websocket session revalidation cadence (ms)
WS_SESSION_REVALIDATE_MS=3000
# Optional redis pub/sub channel for cross-instance websocket fanout
WS_REDIS_CHANNEL=blitzmine:chat:events
LOCAL_DEV_FAUCET_ENABLED=false
FRONTEND_URL=http://localhost:3000
FRONTEND_URLS=http://localhost:3000,http://127.0.0.1:3000
